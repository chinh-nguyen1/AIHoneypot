FROM php:8.2-apache

# Cài đặt extension MySQLi
RUN docker-php-ext-install mysqli pdo pdo_mysql
RUN a2enmod rewrite

# Đổi thư mục gốc của Apache sang /var/www/html/public
ENV APACHE_DOCUMENT_ROOT /var/www/html/public
RUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/sites-available/*.conf
RUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/apache2.conf /etc/apache2/conf-available/*.conf

# Copy mã nguồn Web bẫy
COPY 1_decoy_web/ /var/www/html/

# Tạo thư mục logs và cấp quyền
RUN mkdir -p /var/www/html/logs && chmod -R 777 /var/www/html/logs

EXPOSE 80