FROM python:3.12-slim

WORKDIR /app

# Use the same pinned runtime dependencies as the host training environment.
COPY 3_ai_engine/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY 3_ai_engine/ .

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]